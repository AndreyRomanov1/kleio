{
  "name": "grove",
  "displayName": "Grove",
  "description": "JetBrains-style Git log, diff and history for VS Code",
  "version": "0.3.0",
  "publisher": "aroma",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onWebviewPanel:grove.logPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "grove",
          "title": "Git Log",
          "icon": "media/grove.svg"
        }
      ],
      "activitybar": [
        {
          "id": "grove-commit",
          "title": "Коммит",
          "icon": "media/commit.svg"
        }
      ]
    },
    "views": {
      "grove": [
        {
          "id": "grove.log",
          "type": "webview",
          "name": "Log",
          "icon": "media/grove.svg"
        }
      ],
      "grove-commit": [
        {
          "id": "grove.commit",
          "type": "webview",
          "name": "Коммит",
          "icon": "media/commit.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "grove.log.focusView",
        "title": "Показать лог",
        "category": "Grove"
      },
      {
        "command": "grove.log.openInEditor",
        "title": "Открыть лог во вкладке",
        "category": "Grove",
        "icon": "$(link-external)"
      },
      {
        "command": "grove.log.openInNewWindow",
        "title": "Открыть лог в отдельном окне",
        "category": "Grove",
        "icon": "$(empty-window)"
      },
      {
        "command": "grove.diff.previousChange",
        "title": "Предыдущее изменение (с переходом в предыдущий файл)",
        "category": "Grove",
        "icon": "$(chevron-up)",
        "enablement": "grove.inChangeSet"
      },
      {
        "command": "grove.diff.nextChange",
        "title": "Следующее изменение (с переходом в следующий файл)",
        "category": "Grove",
        "icon": "$(chevron-down)",
        "enablement": "grove.inChangeSet"
      },
      {
        "command": "grove.diff.previousFile",
        "title": "Предыдущий файл",
        "category": "Grove",
        "icon": "$(arrow-left)",
        "enablement": "grove.inChangeSet"
      },
      {
        "command": "grove.diff.nextFile",
        "title": "Следующий файл",
        "category": "Grove",
        "icon": "$(arrow-right)",
        "enablement": "grove.inChangeSet"
      },
      {
        "command": "grove.diff.selectFile",
        "title": "Файлы набора изменений…",
        "category": "Grove",
        "icon": "$(list-tree)",
        "enablement": "grove.inChangeSet"
      },
      {
        "command": "grove.diff.openCurrent",
        "title": "Открыть текущую версию для правки",
        "category": "Grove",
        "icon": "$(edit)",
        "enablement": "grove.inChangeSet"
      },
      {
        "command": "grove.blame.show",
        "title": "Аннотации Git (blame)",
        "category": "Grove",
        "icon": "$(person)"
      },
      {
        "command": "grove.blame.hide",
        "title": "Скрыть аннотации Git",
        "category": "Grove"
      },
      {
        "command": "grove.blame.lineInLog",
        "title": "Показать коммит строки в логе",
        "category": "Grove"
      },
      {
        "command": "grove.history.file",
        "title": "История файла",
        "category": "Grove",
        "icon": "$(history)"
      },
      {
        "command": "grove.history.selection",
        "title": "История выделенного фрагмента",
        "category": "Grove"
      },
      {
        "command": "grove.compare.withRevision",
        "title": "Сравнить с веткой или ревизией…",
        "category": "Grove"
      },
      {
        "command": "grove.blame.toggle",
        "title": "Переключить аннотации Git (blame)",
        "category": "Grove"
      },
      {
        "command": "grove.hosting.openFile",
        "title": "Открыть в GitLab/GitHub",
        "category": "Grove",
        "icon": "$(link-external)"
      },
      {
        "command": "grove.hosting.copyFileLink",
        "title": "Копировать ссылку на GitLab/GitHub",
        "category": "Grove"
      },
      {
        "command": "grove.gitlab.connect",
        "title": "Подключить GitLab…",
        "category": "Grove"
      },
      {
        "command": "grove.gitlab.disconnect",
        "title": "Удалить токен GitLab из Grove…",
        "category": "Grove"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "grove.log.openInEditor",
          "when": "view == grove.log",
          "group": "navigation@1"
        },
        {
          "command": "grove.log.openInNewWindow",
          "when": "view == grove.log",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "grove.diff.previousFile",
          "when": "grove.inChangeSet",
          "group": "navigation@-20"
        },
        {
          "command": "grove.diff.selectFile",
          "when": "grove.inChangeSet",
          "group": "navigation@-19"
        },
        {
          "command": "grove.diff.nextFile",
          "when": "grove.inChangeSet",
          "group": "navigation@-18"
        },
        {
          "command": "grove.diff.previousChange",
          "when": "grove.inChangeSet",
          "group": "navigation@-17"
        },
        {
          "command": "grove.diff.nextChange",
          "when": "grove.inChangeSet",
          "group": "navigation@-16"
        },
        {
          "command": "grove.diff.openCurrent",
          "when": "grove.inChangeSet",
          "group": "navigation@-15"
        }
      ],
      "commandPalette": [
        {
          "command": "grove.diff.previousChange",
          "when": "grove.inChangeSet"
        },
        {
          "command": "grove.diff.nextChange",
          "when": "grove.inChangeSet"
        },
        {
          "command": "grove.diff.previousFile",
          "when": "grove.inChangeSet"
        },
        {
          "command": "grove.diff.nextFile",
          "when": "grove.inChangeSet"
        },
        {
          "command": "grove.diff.selectFile",
          "when": "grove.inChangeSet"
        },
        {
          "command": "grove.diff.openCurrent",
          "when": "grove.inChangeSet"
        },
        {
          "command": "grove.blame.show",
          "when": "editorIsOpen && !grove.blameActive"
        },
        {
          "command": "grove.blame.hide",
          "when": "grove.blameActive"
        },
        {
          "command": "grove.history.selection",
          "when": "editorHasSelection"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "grove.blame.show",
          "when": "!grove.blameActive",
          "group": "grove@1"
        },
        {
          "command": "grove.blame.hide",
          "when": "grove.blameActive",
          "group": "grove@1"
        },
        {
          "command": "grove.blame.lineInLog",
          "group": "grove@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "grove.editorGit",
          "group": "grove@1"
        }
      ],
      "grove.editorGit": [
        {
          "command": "grove.blame.show",
          "when": "!grove.blameActive",
          "group": "1_blame@1"
        },
        {
          "command": "grove.blame.hide",
          "when": "grove.blameActive",
          "group": "1_blame@1"
        },
        {
          "command": "grove.blame.lineInLog",
          "group": "1_blame@2"
        },
        {
          "command": "grove.history.file",
          "group": "2_history@1"
        },
        {
          "command": "grove.history.selection",
          "when": "editorHasSelection",
          "group": "2_history@2"
        },
        {
          "command": "grove.compare.withRevision",
          "group": "3_compare@1"
        },
        {
          "command": "grove.hosting.openFile",
          "group": "4_hosting@1"
        },
        {
          "command": "grove.hosting.copyFileLink",
          "group": "4_hosting@2"
        }
      ],
      "explorer/context": [
        {
          "command": "grove.history.file",
          "when": "!explorerResourceIsFolder",
          "group": "7_grove@1"
        },
        {
          "command": "grove.compare.withRevision",
          "when": "!explorerResourceIsFolder",
          "group": "7_grove@2"
        },
        {
          "command": "grove.hosting.openFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_grove@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "grove.history.file",
          "group": "7_grove@1"
        },
        {
          "command": "grove.compare.withRevision",
          "group": "7_grove@2"
        },
        {
          "command": "grove.hosting.openFile",
          "group": "7_grove@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "grove.diff.nextChange",
        "key": "f7",
        "when": "grove.inChangeSet && textCompareEditorVisible"
      },
      {
        "command": "grove.diff.previousChange",
        "key": "shift+f7",
        "when": "grove.inChangeSet && textCompareEditorVisible"
      },
      {
        "command": "grove.diff.openCurrent",
        "key": "f4",
        "when": "grove.inChangeSet && textCompareEditorVisible"
      }
    ],
    "submenus": [
      {
        "id": "grove.editorGit",
        "label": "Git"
      }
    ],
    "configuration": {
      "title": "Grove",
      "properties": {
        "grove.codeLens.authors": {
          "type": "boolean",
          "default": true,
          "description": "Показывать над классами и методами автора большинства строк и число других авторов (как code vision в Rider)."
        },
        "grove.history.showDiffOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "Во вкладке истории сразу показывать diff выбранного коммита в соседней группе редактора."
        },
        "grove.autolinks": {
          "type": "array",
          "default": [],
          "markdownDescription": "Правила, превращающие текст сообщений коммитов в ссылки: регулярное выражение и адрес с `$0` (всё совпадение), `$1`… (группы). Например, `{\"pattern\": \"PROJ-\\\\d+\", \"url\": \"https://youtrack.example.com/issue/$0\"}`. Удобно задать в `.vscode/settings.json` репозитория — правило будет у всей команды. Ссылки на MR (`!12`) и issues (`#12`) GitLab и GitHub добавляются сами.",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "url"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Регулярное выражение (JavaScript)."
              },
              "url": {
                "type": "string",
                "description": "Адрес ссылки, `$0` — совпадение, `$1`… — группы."
              }
            }
          }
        },
        "grove.hosting.instances": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "gitlab",
              "github"
            ]
          },
          "markdownDescription": "Тип хостинга для своих серверов, если Grove не определил его сам: `{\"git.example.com\": \"gitlab\"}`. github.com и gitlab.com известны; сервер GitLab обычно определяется сам по ссылкам на merge requests."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p . && svelte-check --tsconfig ./tsconfig.webview.json --fail-on-warnings",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node scripts/integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/build.mjs && esbuild scripts/preview/server.ts --bundle --platform=node --target=node20 --log-level=warning --outfile=dist/preview/server.js && node dist/preview/server.js",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --allow-missing-repository -o grove.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.100.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
