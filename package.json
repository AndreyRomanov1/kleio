{
  "name": "kleio",
  "displayName": "Kleio",
  "description": "Git the JetBrains way: commit graph, one diff viewer for any changes, history, blame, interactive rebase, conflicts, GitLab merge requests and review",
  "version": "0.13.0",
  "publisher": "aroma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreyRomanov1/kleio.git"
  },
  "bugs": {
    "url": "https://github.com/AndreyRomanov1/kleio/issues"
  },
  "homepage": "https://github.com/AndreyRomanov1/kleio#readme",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Kleio запускает git, а git выполняет хуки и настройки из репозитория."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Kleio работает с git в локальных папках."
    }
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kleio",
          "title": "Git Log",
          "icon": "media/kleio.svg"
        }
      ],
      "activitybar": [
        {
          "id": "kleio-commit",
          "title": "Коммит",
          "icon": "media/commit.svg"
        }
      ]
    },
    "views": {
      "kleio": [
        {
          "id": "kleio.log",
          "type": "webview",
          "name": "Log",
          "icon": "media/kleio.svg"
        }
      ],
      "kleio-commit": [
        {
          "id": "kleio.commit",
          "type": "webview",
          "name": "Коммит",
          "icon": "media/commit.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "kleio.log.focusView",
        "title": "Показать лог",
        "category": "Kleio"
      },
      {
        "command": "kleio.log.openInEditor",
        "title": "Открыть лог во вкладке",
        "category": "Kleio",
        "icon": "$(link-external)"
      },
      {
        "command": "kleio.log.openInNewWindow",
        "title": "Открыть лог в отдельном окне",
        "category": "Kleio",
        "icon": "$(empty-window)"
      },
      {
        "command": "kleio.diff.previousChange",
        "title": "Предыдущее изменение (с переходом в предыдущий файл)",
        "category": "Kleio",
        "icon": "$(chevron-up)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.nextChange",
        "title": "Следующее изменение (с переходом в следующий файл)",
        "category": "Kleio",
        "icon": "$(chevron-down)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.previousFile",
        "title": "Предыдущий файл",
        "category": "Kleio",
        "icon": "$(arrow-left)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.nextFile",
        "title": "Следующий файл",
        "category": "Kleio",
        "icon": "$(arrow-right)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.selectFile",
        "title": "Файлы набора изменений…",
        "category": "Kleio",
        "icon": "$(list-tree)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.openCurrent",
        "title": "Открыть текущую версию для правки",
        "category": "Kleio",
        "icon": "$(edit)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.blame.show",
        "title": "Аннотации Git (blame)",
        "category": "Kleio",
        "icon": "$(person)"
      },
      {
        "command": "kleio.blame.hide",
        "title": "Скрыть аннотации Git",
        "category": "Kleio"
      },
      {
        "command": "kleio.blame.lineInLog",
        "title": "Показать коммит строки в логе",
        "category": "Kleio"
      },
      {
        "command": "kleio.history.file",
        "title": "История файла",
        "category": "Kleio",
        "icon": "$(history)"
      },
      {
        "command": "kleio.history.selection",
        "title": "История выделенного фрагмента",
        "category": "Kleio"
      },
      {
        "command": "kleio.compare.withRevision",
        "title": "Сравнить с веткой или ревизией…",
        "category": "Kleio"
      },
      {
        "command": "kleio.blame.toggle",
        "title": "Переключить аннотации Git (blame)",
        "category": "Kleio"
      },
      {
        "command": "kleio.hosting.openFile",
        "title": "Открыть в GitLab/GitHub",
        "category": "Kleio",
        "icon": "$(link-external)"
      },
      {
        "command": "kleio.hosting.copyFileLink",
        "title": "Копировать ссылку на GitLab/GitHub",
        "category": "Kleio"
      },
      {
        "command": "kleio.gitlab.connect",
        "title": "Подключить GitLab…",
        "category": "Kleio"
      },
      {
        "command": "kleio.gitlab.disconnect",
        "title": "Удалить токен GitLab из Kleio…",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.publish",
        "title": "Опубликовать",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.draft",
        "title": "В черновик",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.resolve",
        "title": "Решено",
        "category": "Kleio",
        "icon": "$(check)"
      },
      {
        "command": "kleio.review.unresolve",
        "title": "Открыть снова",
        "category": "Kleio",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "kleio.review.deleteDraft",
        "title": "Удалить черновик",
        "category": "Kleio",
        "icon": "$(trash)"
      },
      {
        "command": "kleio.review.publishDrafts",
        "title": "Опубликовать черновики ревью",
        "category": "Kleio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "kleio.review.refresh",
        "title": "Обновить обсуждения ревью",
        "category": "Kleio",
        "icon": "$(refresh)"
      },
      {
        "command": "kleio.review.end",
        "title": "Закончить ревью",
        "category": "Kleio",
        "icon": "$(close-all)"
      },
      {
        "command": "kleio.review.openJournal",
        "title": "Журнал комментариев ревью",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.previousComment",
        "title": "Предыдущее замечание ревью",
        "category": "Kleio",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "kleio.review.nextComment",
        "title": "Следующее замечание ревью",
        "category": "Kleio",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "kleio.git.updateProject",
        "title": "Обновить проект",
        "category": "Kleio",
        "icon": "$(repo-pull)"
      },
      {
        "command": "kleio.git.push",
        "title": "Push…",
        "category": "Kleio",
        "icon": "$(repo-push)"
      },
      {
        "command": "kleio.conflicts.show",
        "title": "Конфликты",
        "category": "Kleio",
        "icon": "$(warning)"
      },
      {
        "command": "kleio.conflicts.markResolved",
        "title": "Завершить слияние и отметить как разрешённый",
        "category": "Kleio",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kleio.log.openInEditor",
          "when": "view == kleio.log",
          "group": "navigation@1"
        },
        {
          "command": "kleio.log.openInNewWindow",
          "when": "view == kleio.log",
          "group": "navigation@2"
        },
        {
          "command": "kleio.git.updateProject",
          "when": "view == kleio.commit",
          "group": "navigation@1"
        },
        {
          "command": "kleio.git.push",
          "when": "view == kleio.commit",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "kleio.diff.previousFile",
          "when": "kleio.inChangeSet",
          "group": "navigation@-20"
        },
        {
          "command": "kleio.diff.selectFile",
          "when": "kleio.inChangeSet",
          "group": "navigation@-19"
        },
        {
          "command": "kleio.diff.nextFile",
          "when": "kleio.inChangeSet",
          "group": "navigation@-18"
        },
        {
          "command": "kleio.diff.previousChange",
          "when": "kleio.inChangeSet",
          "group": "navigation@-17"
        },
        {
          "command": "kleio.diff.nextChange",
          "when": "kleio.inChangeSet",
          "group": "navigation@-16"
        },
        {
          "command": "kleio.diff.openCurrent",
          "when": "kleio.inChangeSet && !kleio.reviewActive",
          "group": "navigation@-15"
        },
        {
          "command": "kleio.diff.openCurrent",
          "when": "kleio.inChangeSet && kleio.reviewActive",
          "group": "1_kleio_review@1"
        },
        {
          "command": "kleio.review.publishDrafts",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "1_kleio_review@2"
        },
        {
          "command": "kleio.review.refresh",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "1_kleio_review@3"
        },
        {
          "command": "kleio.review.previousComment",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "navigation@-5"
        },
        {
          "command": "kleio.review.nextComment",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "navigation@-4"
        },
        {
          "command": "kleio.conflicts.markResolved",
          "when": "isMergeEditor && mergeEditorBaseUri =~ /^kleio:/",
          "group": "navigation@-30"
        }
      ],
      "commandPalette": [
        {
          "command": "kleio.diff.previousChange",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.nextChange",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.previousFile",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.nextFile",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.selectFile",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.openCurrent",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.blame.show",
          "when": "editorIsOpen && !kleio.blameActive"
        },
        {
          "command": "kleio.blame.hide",
          "when": "kleio.blameActive"
        },
        {
          "command": "kleio.history.selection",
          "when": "editorHasSelection"
        },
        {
          "command": "kleio.review.publish",
          "when": "false"
        },
        {
          "command": "kleio.review.draft",
          "when": "false"
        },
        {
          "command": "kleio.review.resolve",
          "when": "false"
        },
        {
          "command": "kleio.review.unresolve",
          "when": "false"
        },
        {
          "command": "kleio.review.deleteDraft",
          "when": "false"
        },
        {
          "command": "kleio.review.publishDrafts",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.refresh",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.end",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.previousComment",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.nextComment",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.conflicts.markResolved",
          "when": "isMergeEditor || editorTextFocus"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "kleio.blame.show",
          "when": "!kleio.blameActive",
          "group": "kleio@1"
        },
        {
          "command": "kleio.blame.hide",
          "when": "kleio.blameActive",
          "group": "kleio@1"
        },
        {
          "command": "kleio.blame.lineInLog",
          "group": "kleio@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "kleio.editorGit",
          "group": "kleio@1"
        }
      ],
      "kleio.editorGit": [
        {
          "command": "kleio.blame.show",
          "when": "!kleio.blameActive",
          "group": "1_blame@1"
        },
        {
          "command": "kleio.blame.hide",
          "when": "kleio.blameActive",
          "group": "1_blame@1"
        },
        {
          "command": "kleio.blame.lineInLog",
          "group": "1_blame@2"
        },
        {
          "command": "kleio.history.file",
          "group": "2_history@1"
        },
        {
          "command": "kleio.history.selection",
          "when": "editorHasSelection",
          "group": "2_history@2"
        },
        {
          "command": "kleio.compare.withRevision",
          "group": "3_compare@1"
        },
        {
          "command": "kleio.hosting.openFile",
          "group": "4_hosting@1"
        },
        {
          "command": "kleio.hosting.copyFileLink",
          "group": "4_hosting@2"
        }
      ],
      "explorer/context": [
        {
          "command": "kleio.history.file",
          "when": "!explorerResourceIsFolder",
          "group": "7_kleio@1"
        },
        {
          "command": "kleio.compare.withRevision",
          "when": "!explorerResourceIsFolder",
          "group": "7_kleio@2"
        },
        {
          "command": "kleio.hosting.openFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_kleio@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "kleio.history.file",
          "group": "7_kleio@1"
        },
        {
          "command": "kleio.compare.withRevision",
          "group": "7_kleio@2"
        },
        {
          "command": "kleio.hosting.openFile",
          "group": "7_kleio@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "kleio.review.publish",
          "group": "inline@1",
          "when": "commentController == kleio.review"
        },
        {
          "command": "kleio.review.draft",
          "group": "inline@2",
          "when": "commentController == kleio.review && commentThread != draft"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "kleio.review.resolve",
          "group": "inline@1",
          "when": "commentController == kleio.review && commentThread == unresolved"
        },
        {
          "command": "kleio.review.unresolve",
          "group": "inline@1",
          "when": "commentController == kleio.review && commentThread == resolved"
        }
      ],
      "comments/comment/title": [
        {
          "command": "kleio.review.deleteDraft",
          "group": "inline@1",
          "when": "commentController == kleio.review && comment == draft"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kleio.diff.nextChange",
        "key": "f7",
        "when": "kleio.inChangeSet && textCompareEditorVisible"
      },
      {
        "command": "kleio.diff.previousChange",
        "key": "shift+f7",
        "when": "kleio.inChangeSet && textCompareEditorVisible"
      },
      {
        "command": "kleio.diff.openCurrent",
        "key": "f4",
        "when": "kleio.inChangeSet && textCompareEditorVisible"
      },
      {
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "command": "kleio.conflicts.markResolved",
        "when": "isMergeEditor && mergeEditorBaseUri =~ /^kleio:/"
      }
    ],
    "submenus": [
      {
        "id": "kleio.editorGit",
        "label": "Git"
      }
    ],
    "configuration": {
      "title": "Kleio",
      "properties": {
        "kleio.codeLens.authors": {
          "type": "boolean",
          "default": true,
          "description": "Показывать над классами и методами автора большинства строк и число других авторов (как code vision в Rider)."
        },
        "kleio.history.showDiffOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "Во вкладке истории сразу показывать diff выбранного коммита в соседней группе редактора."
        },
        "kleio.autolinks": {
          "type": "array",
          "default": [],
          "markdownDescription": "Правила, превращающие текст сообщений коммитов в ссылки: регулярное выражение и адрес с `$0` (всё совпадение), `$1`… (группы). Например, `{\"pattern\": \"PROJ-\\\\d+\", \"url\": \"https://youtrack.example.com/issue/$0\"}`. Удобно задать в `.vscode/settings.json` репозитория — правило будет у всей команды. Ссылки на MR (`!12`) и issues (`#12`) GitLab и GitHub добавляются сами.",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "url"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Регулярное выражение (JavaScript)."
              },
              "url": {
                "type": "string",
                "description": "Адрес ссылки, `$0` — совпадение, `$1`… — группы."
              }
            }
          }
        },
        "kleio.hosting.instances": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "gitlab",
              "github"
            ]
          },
          "markdownDescription": "Тип хостинга для своих серверов, если Kleio не определил его сам: `{\"git.example.com\": \"gitlab\"}`. github.com и gitlab.com известны; сервер GitLab обычно определяется сам по ссылкам на merge requests."
        },
        "kleio.update.method": {
          "type": "string",
          "enum": [
            "ask",
            "merge",
            "rebase"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Спросить при первом обновлении и запомнить ответ",
            "Пришедшие коммиты вливаются merge-коммитом, как git pull",
            "Свои коммиты перебазируются поверх пришедших, как git pull --rebase"
          ],
          "markdownDescription": "Как «Обновить проект» подтягивает текущую ветку из upstream, когда в ней есть свои коммиты. Без своих коммитов ветка просто переезжает вперёд (fast-forward)."
        },
        "kleio.push.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "master",
            "main"
          ],
          "markdownDescription": "Ветки на сервере, в которые push с force запрещён. Можно использовать `*`, например `release/*`."
        },
        "kleio.worktree.path": {
          "type": "string",
          "default": "${repoParent}/${repoName}-${branch}",
          "markdownDescription": "Папка нового worktree при «Checkout в новый worktree…». `${repoParent}` — папка, где лежит основная папка репозитория, `${repoName}` — её имя, `${branch}` — имя ветки (`/` заменяется на `-`). Путь можно поправить перед созданием."
        },
        "kleio.worktree.copyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Файлы, которые копируются из основной папки в новый worktree, — то, что git не хранит, но без чего проект не запустить, например `settings/vault.json`. Пути относительно корня репозитория."
        },
        "kleio.hosting.backgroundRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Раз в несколько минут при обновлении лога запрашивать у сервера ссылки на merge requests (`git ls-remote`). Выключите, если сервер каждый раз спрашивает пароль SSH-ключа: тогда ссылки запрашиваются при открытии лога и после Fetch."
        },
        "kleio.commit.stagingArea": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Окно коммита работает с индексом git (stage), как `git commit` и встроенный Git VS Code: галочки показывают, что в stage, и меняют его, а коммитится содержимое stage. Выключено — как в Rider: коммитятся отмеченные файлы и куски в том виде, в каком они на диске, stage не учитывается. Переключается и галкой «Stage» в окне коммита."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p . && svelte-check --tsconfig ./tsconfig.webview.json --fail-on-warnings",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node scripts/integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/build.mjs && esbuild scripts/preview/server.ts --bundle --platform=node --target=node20 --log-level=warning --outfile=dist/preview/server.js && node dist/preview/server.js",
