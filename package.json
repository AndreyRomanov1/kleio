{
  "name": "kleio",
  "displayName": "Kleio",
  "description": "Git the JetBrains way: commit graph, one diff viewer for any changes, history, blame, interactive rebase, conflicts, GitLab merge requests and review",
  "version": "0.21.0",
  "publisher": "aroma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreyRomanov1/kleio.git"
  },
  "bugs": {
    "url": "https://github.com/AndreyRomanov1/kleio/issues"
  },
  "homepage": "https://github.com/AndreyRomanov1/kleio#readme",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:.git",
    "onFileSystem:kleio",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtual%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kleio",
          "title": "Git Log",
          "icon": "media/kleio.svg"
        }
      ],
      "activitybar": [
        {
          "id": "kleio-commit",
          "title": "%view.commit%",
          "icon": "media/commit.svg"
        }
      ]
    },
    "views": {
      "kleio": [
        {
          "id": "kleio.log",
          "type": "webview",
          "name": "Log",
          "icon": "media/kleio.svg"
        }
      ],
      "kleio-commit": [
        {
          "id": "kleio.commit",
          "type": "webview",
          "name": "%view.commit%",
          "icon": "media/commit.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "kleio.log.focusView",
        "title": "%command.log.focusView%",
        "category": "Kleio"
      },
      {
        "command": "kleio.log.openInEditor",
        "title": "%command.log.openInEditor%",
        "category": "Kleio",
        "icon": "$(link-external)"
      },
      {
        "command": "kleio.log.openInNewWindow",
        "title": "%command.log.openInNewWindow%",
        "category": "Kleio",
        "icon": "$(empty-window)"
      },
      {
        "command": "kleio.diff.previousChange",
        "title": "%command.diff.previousChange%",
        "category": "Kleio",
        "icon": "$(chevron-up)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.nextChange",
        "title": "%command.diff.nextChange%",
        "category": "Kleio",
        "icon": "$(chevron-down)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.previousFile",
        "title": "%command.diff.previousFile%",
        "category": "Kleio",
        "icon": "$(arrow-left)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.nextFile",
        "title": "%command.diff.nextFile%",
        "category": "Kleio",
        "icon": "$(arrow-right)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.navigate.back",
        "title": "%command.navigate.back%",
        "category": "Kleio"
      },
      {
        "command": "kleio.navigate.forward",
        "title": "%command.navigate.forward%",
        "category": "Kleio"
      },
      {
        "command": "kleio.diff.selectFile",
        "title": "%command.diff.selectFile%",
        "category": "Kleio",
        "icon": "$(list-tree)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.diff.openCurrent",
        "title": "%command.diff.openCurrent%",
        "category": "Kleio",
        "icon": "$(edit)",
        "enablement": "kleio.inChangeSet"
      },
      {
        "command": "kleio.blame.show",
        "title": "%command.blame.show%",
        "category": "Kleio",
        "icon": "$(person)"
      },
      {
        "command": "kleio.blame.hide",
        "title": "%command.blame.hide%",
        "category": "Kleio"
      },
      {
        "command": "kleio.blame.lineInLog",
        "title": "%command.blame.lineInLog%",
        "category": "Kleio"
      },
      {
        "command": "kleio.history.file",
        "title": "%command.history.file%",
        "category": "Kleio",
        "icon": "$(history)"
      },
      {
        "command": "kleio.history.folder",
        "title": "%command.history.folder%",
        "category": "Kleio",
        "icon": "$(history)"
      },
      {
        "command": "kleio.history.selection",
        "title": "%command.history.selection%",
        "category": "Kleio"
      },
      {
        "command": "kleio.compare.withRevision",
        "title": "%command.compare.withRevision%",
        "category": "Kleio"
      },
      {
        "command": "kleio.blame.toggle",
        "title": "%command.blame.toggle%",
        "category": "Kleio"
      },
      {
        "command": "kleio.hosting.openFile",
        "title": "%command.hosting.openFile%",
        "category": "Kleio",
        "icon": "$(link-external)"
      },
      {
        "command": "kleio.hosting.copyFileLink",
        "title": "%command.hosting.copyFileLink%",
        "category": "Kleio"
      },
      {
        "command": "kleio.hosting.selectRemote",
        "title": "%command.hosting.selectRemote%",
        "category": "Kleio"
      },
      {
        "command": "kleio.gitlab.connect",
        "title": "%command.gitlab.connect%",
        "category": "Kleio"
      },
      {
        "command": "kleio.gitlab.disconnect",
        "title": "%command.gitlab.disconnect%",
        "category": "Kleio"
      },
      {
        "command": "kleio.github.connect",
        "title": "%command.github.connect%",
        "category": "Kleio"
      },
      {
        "command": "kleio.github.disconnect",
        "title": "%command.github.disconnect%",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.publish",
        "title": "%command.review.publish%",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.draft",
        "title": "%command.review.draft%",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.resolve",
        "title": "%command.review.resolve%",
        "category": "Kleio",
        "icon": "$(check)"
      },
      {
        "command": "kleio.review.unresolve",
        "title": "%command.review.unresolve%",
        "category": "Kleio",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "kleio.review.deleteDraft",
        "title": "%command.review.deleteDraft%",
        "category": "Kleio",
        "icon": "$(trash)"
      },
      {
        "command": "kleio.review.editComment",
        "title": "%command.review.editComment%",
        "category": "Kleio",
        "icon": "$(edit)"
      },
      {
        "command": "kleio.review.deleteComment",
        "title": "%command.review.deleteComment%",
        "category": "Kleio",
        "icon": "$(trash)"
      },
      {
        "command": "kleio.review.saveComment",
        "title": "%command.review.saveComment%",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.cancelEdit",
        "title": "%command.review.cancelEdit%",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.publishDrafts",
        "title": "%command.review.publishDrafts%",
        "category": "Kleio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "kleio.review.refresh",
        "title": "%command.review.refresh%",
        "category": "Kleio",
        "icon": "$(refresh)"
      },
      {
        "command": "kleio.review.end",
        "title": "%command.review.end%",
        "category": "Kleio",
        "icon": "$(close-all)"
      },
      {
        "command": "kleio.review.sinceLastReview",
        "title": "%command.review.sinceLastReview%",
        "category": "Kleio",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "kleio.review.openJournal",
        "title": "%command.review.openJournal%",
        "category": "Kleio"
      },
      {
        "command": "kleio.review.previousComment",
        "title": "%command.review.previousComment%",
        "category": "Kleio",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "kleio.review.nextComment",
        "title": "%command.review.nextComment%",
        "category": "Kleio",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "kleio.git.updateProject",
        "title": "%command.git.updateProject%",
        "category": "Kleio",
        "icon": "$(repo-pull)"
      },
      {
        "command": "kleio.git.undo",
        "title": "%command.git.undo%",
        "category": "Kleio",
        "icon": "$(discard)"
      },
      {
        "command": "kleio.git.applyPatch",
        "title": "%command.git.applyPatch%",
        "category": "Kleio"
      },
      {
        "command": "kleio.git.push",
        "title": "Push…",
        "category": "Kleio",
        "icon": "$(repo-push)"
      },
      {
        "command": "kleio.conflicts.show",
        "title": "%command.conflicts.show%",
        "category": "Kleio",
        "icon": "$(warning)"
      },
      {
        "command": "kleio.conflicts.markResolved",
        "title": "%command.conflicts.markResolved%",
        "category": "Kleio",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kleio.log.openInEditor",
          "when": "view == kleio.log",
          "group": "navigation@1"
        },
        {
          "command": "kleio.log.openInNewWindow",
          "when": "view == kleio.log",
          "group": "navigation@2"
        },
        {
          "command": "kleio.git.updateProject",
          "when": "view == kleio.commit",
          "group": "navigation@1"
        },
        {
          "command": "kleio.git.push",
          "when": "view == kleio.commit",
          "group": "navigation@2"
        },
        {
          "command": "kleio.git.undo",
          "when": "view == kleio.log",
          "group": "overflow@1"
        },
        {
          "command": "kleio.git.undo",
          "when": "view == kleio.commit",
          "group": "overflow@1"
        },
        {
          "command": "kleio.git.applyPatch",
          "when": "view == kleio.log",
          "group": "overflow@2"
        },
        {
          "command": "kleio.git.applyPatch",
          "when": "view == kleio.commit",
          "group": "overflow@2"
        }
      ],
      "editor/title": [
        {
          "command": "kleio.diff.previousFile",
          "when": "kleio.inChangeSet",
          "group": "navigation@-20"
        },
        {
          "command": "kleio.diff.selectFile",
          "when": "kleio.inChangeSet",
          "group": "navigation@-19"
        },
        {
          "command": "kleio.diff.nextFile",
          "when": "kleio.inChangeSet",
          "group": "navigation@-18"
        },
        {
          "command": "kleio.diff.previousChange",
          "when": "kleio.inChangeSet",
          "group": "navigation@-17"
        },
        {
          "command": "kleio.diff.nextChange",
          "when": "kleio.inChangeSet",
          "group": "navigation@-16"
        },
        {
          "command": "kleio.diff.openCurrent",
          "when": "kleio.inChangeSet && !kleio.reviewActive",
          "group": "navigation@-15"
        },
        {
          "command": "kleio.diff.openCurrent",
          "when": "kleio.inChangeSet && kleio.reviewActive",
          "group": "1_kleio_review@1"
        },
        {
          "command": "kleio.review.publishDrafts",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "1_kleio_review@2"
        },
        {
          "command": "kleio.review.refresh",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "1_kleio_review@3"
        },
        {
          "command": "kleio.review.sinceLastReview",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "1_kleio_review@4"
        },
        {
          "command": "kleio.review.previousComment",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "navigation@-5"
        },
        {
          "command": "kleio.review.nextComment",
          "when": "kleio.reviewActive && kleio.inChangeSet",
          "group": "navigation@-4"
        },
        {
          "command": "kleio.conflicts.markResolved",
          "when": "isMergeEditor && mergeEditorBaseUri =~ /^kleio:/",
          "group": "navigation@-30"
        }
      ],
      "commandPalette": [
        {
          "command": "kleio.diff.previousChange",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.nextChange",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.previousFile",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.nextFile",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.selectFile",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.diff.openCurrent",
          "when": "kleio.inChangeSet"
        },
        {
          "command": "kleio.blame.show",
          "when": "editorIsOpen && !kleio.blameActive"
        },
        {
          "command": "kleio.blame.hide",
          "when": "kleio.blameActive"
        },
        {
          "command": "kleio.history.selection",
          "when": "editorHasSelection"
        },
        {
          "command": "kleio.review.publish",
          "when": "false"
        },
        {
          "command": "kleio.review.draft",
          "when": "false"
        },
        {
          "command": "kleio.review.resolve",
          "when": "false"
        },
        {
          "command": "kleio.review.unresolve",
          "when": "false"
        },
        {
          "command": "kleio.review.deleteDraft",
          "when": "false"
        },
        {
          "command": "kleio.review.editComment",
          "when": "false"
        },
        {
          "command": "kleio.review.deleteComment",
          "when": "false"
        },
        {
          "command": "kleio.review.saveComment",
          "when": "false"
        },
        {
          "command": "kleio.review.cancelEdit",
          "when": "false"
        },
        {
          "command": "kleio.review.publishDrafts",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.refresh",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.end",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.sinceLastReview",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.previousComment",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.review.nextComment",
          "when": "kleio.reviewActive"
        },
        {
          "command": "kleio.conflicts.markResolved",
          "when": "isMergeEditor || editorTextFocus"
        },
        {
          "command": "kleio.history.folder",
          "when": "false"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "kleio.blame.show",
          "when": "!kleio.blameActive",
          "group": "kleio@1"
        },
        {
          "command": "kleio.blame.hide",
          "when": "kleio.blameActive",
          "group": "kleio@1"
        },
        {
          "command": "kleio.blame.lineInLog",
          "group": "kleio@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "kleio.editorGit",
          "group": "kleio@1"
        }
      ],
      "kleio.editorGit": [
        {
          "command": "kleio.blame.show",
          "when": "!kleio.blameActive",
          "group": "1_blame@1"
        },
        {
          "command": "kleio.blame.hide",
          "when": "kleio.blameActive",
          "group": "1_blame@1"
        },
        {
          "command": "kleio.blame.lineInLog",
          "group": "1_blame@2"
        },
        {
          "command": "kleio.history.file",
          "group": "2_history@1"
        },
        {
          "command": "kleio.history.selection",
          "when": "editorHasSelection",
          "group": "2_history@2"
        },
        {
          "command": "kleio.compare.withRevision",
          "group": "3_compare@1"
        },
        {
          "command": "kleio.hosting.openFile",
          "group": "4_hosting@1"
        },
        {
          "command": "kleio.hosting.copyFileLink",
          "group": "4_hosting@2"
        }
      ],
      "explorer/context": [
        {
          "command": "kleio.history.file",
          "when": "!explorerResourceIsFolder",
          "group": "7_kleio@1"
        },
        {
          "command": "kleio.history.folder",
          "when": "explorerResourceIsFolder",
          "group": "7_kleio@1"
        },
        {
          "command": "kleio.compare.withRevision",
          "when": "!explorerResourceIsFolder",
          "group": "7_kleio@2"
        },
        {
          "command": "kleio.hosting.openFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_kleio@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "kleio.history.file",
          "group": "7_kleio@1"
        },
        {
          "command": "kleio.compare.withRevision",
          "group": "7_kleio@2"
        },
        {
          "command": "kleio.hosting.openFile",
          "group": "7_kleio@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "kleio.review.publish",
          "group": "inline@1",
          "when": "commentController == kleio.review && config.kleio.review.ctrlEnter != draft"
        },
        {
          "command": "kleio.review.draft",
          "group": "inline@2",
          "when": "commentController == kleio.review && commentThread != draft && config.kleio.review.ctrlEnter != draft"
        },
        {
          "command": "kleio.review.draft",
          "group": "inline@1",
          "when": "commentController == kleio.review && commentThread != draft && config.kleio.review.ctrlEnter == draft"
        },
        {
          "command": "kleio.review.publish",
          "group": "inline@2",
          "when": "commentController == kleio.review && (commentThread == draft || config.kleio.review.ctrlEnter == draft)"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "kleio.review.resolve",
          "group": "inline@1",
          "when": "commentController == kleio.review && commentThread == unresolved"
        },
        {
          "command": "kleio.review.unresolve",
          "group": "inline@1",
          "when": "commentController == kleio.review && commentThread == resolved"
        }
      ],
      "comments/comment/title": [
        {
          "command": "kleio.review.editComment",
          "group": "inline@1",
          "when": "commentController == kleio.review && comment =~ /^(mine|draft)$/"
        },
        {
          "command": "kleio.review.deleteDraft",
          "group": "inline@2",
          "when": "commentController == kleio.review && comment == draft"
        },
        {
          "command": "kleio.review.deleteComment",
          "group": "inline@2",
          "when": "commentController == kleio.review && comment == mine"
        }
      ],
      "comments/comment/context": [
        {
          "command": "kleio.review.saveComment",
          "group": "inline@1",
          "when": "commentController == kleio.review"
        },
        {
          "command": "kleio.review.cancelEdit",
          "group": "inline@2",
          "when": "commentController == kleio.review"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.action.submitComment",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused"
      },
      {
        "command": "kleio.navigate.back",
        "key": "ctrl+alt+-",
        "win": "alt+left",
        "mac": "ctrl+-",
        "when": "config.kleio.navigation.history"
      },
      {
        "command": "kleio.navigate.forward",
        "key": "ctrl+shift+-",
        "win": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "config.kleio.navigation.history"
      },
      {
        "command": "kleio.diff.nextChange",
        "key": "f7",
        "when": "kleio.inChangeSet && textCompareEditorVisible"
      },
      {
        "command": "kleio.diff.previousChange",
        "key": "shift+f7",
        "when": "kleio.inChangeSet && textCompareEditorVisible"
      },
      {
        "command": "kleio.diff.openCurrent",
        "key": "f4",
        "when": "kleio.inChangeSet && textCompareEditorVisible"
      },
      {
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "command": "kleio.conflicts.markResolved",
        "when": "isMergeEditor && mergeEditorBaseUri =~ /^kleio:/"
      }
    ],
    "submenus": [
      {
        "id": "kleio.editorGit",
        "label": "Git"
      }
    ],
    "configuration": {
      "title": "Kleio",
      "properties": {
        "kleio.codeLens.authors": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeLens.authors%"
        },
        "kleio.history.showDiffOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.showDiffOnSelect%"
        },
        "kleio.autolinks": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.autolinks%",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "url"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "%config.autolinks.pattern%"
              },
              "url": {
                "type": "string",
                "description": "%config.autolinks.url%"
              }
            }
          }
        },
        "kleio.hosting.instances": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "gitlab",
              "github"
            ]
          },
          "markdownDescription": "%config.hosting.instances%"
        },
        "kleio.navigation.history": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.navigation.history%"
        },
        "kleio.review.ctrlEnter": {
          "type": "string",
          "enum": [
            "publish",
            "draft"
          ],
          "default": "publish",
          "enumDescriptions": [
            "%config.review.ctrlEnter.publish%",
            "%config.review.ctrlEnter.draft%"
          ],
          "markdownDescription": "%config.review.ctrlEnter%"
        },
        "kleio.rebase.updateRefs": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.rebase.updateRefs%"
        },
        "kleio.update.method": {
          "type": "string",
          "enum": [
            "ask",
            "merge",
            "rebase"
          ],
          "default": "ask",
          "enumDescriptions": [
            "%config.update.method.ask%",
            "%config.update.method.merge%",
            "%config.update.method.rebase%"
          ],
          "markdownDescription": "%config.update.method%"
        },
        "kleio.push.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "master",
            "main"
          ],
          "markdownDescription": "%config.push.protectedBranches%"
        },
        "kleio.worktree.path": {
          "type": "string",
          "default": "${repoParent}/${repoName}-${branch}",
          "markdownDescription": "%config.worktree.path%"
        },
        "kleio.worktree.copyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.worktree.copyFiles%"
        },
        "kleio.hosting.backgroundRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.hosting.backgroundRefresh%"
        },
        "kleio.commit.stagingArea": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.commit.stagingArea%"
        },
        "kleio.language": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "%config.language%"
        },
        "kleio.statusBar.branch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.statusBar.branch%"
        },
        "kleio.blame.ignoreWhitespaceAndMoves": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.blame.ignoreWhitespaceAndMoves%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p . && svelte-check --tsconfig ./tsconfig.webview.json --fail-on-warnings",
    "check:l10n": "node scripts/check-l10n.mjs",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node scripts/integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/build.mjs && esbuild scripts/preview/server.ts --bundle --platform=node --target=node20 --log-level=warning --outfile=dist/preview/server.js && node dist/preview/server.js",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --allow-missing-repository -o kleio.vsix"
  },
